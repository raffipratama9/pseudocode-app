import { useState } from 'react'

type PseudocodeExample = {
  id: number
  title: string
  category: string
  icon: string
  description: string
  code: string[]
  explanation: string[]
}

const pseudocodeExamples: PseudocodeExample[] = [
  {
    id: 1,
    title: "Algoritma Bubble Sort",
    category: "Sorting",
    icon: "🫧",
    description: "Mengurutkan array dari kecil ke besar dengan membandingkan elemen berdekatan.",
    code: [
      "ALGORITMA BubbleSort",
      "  INPUT: array bilangan[0..n-1]",
      "  OUTPUT: array terurut dari kecil ke besar",
      "",
      "  UNTUK i = 0 SAMPAI n-1",
      "    UNTUK j = 0 SAMPAI n-i-2",
      "      JIKA bilangan[j] > bilangan[j+1] MAKA",
      "        // Tukar posisi",
      "        temp ← bilangan[j]",
      "        bilangan[j] ← bilangan[j+1]",
      "        bilangan[j+1] ← temp",
      "      AKHIR JIKA",
      "    AKHIR UNTUK",
      "  AKHIR UNTUK",
      "",
      "  KEMBALIKAN bilangan"
    ],
    explanation: [
      "• Algoritma ini membandingkan setiap pasangan elemen yang berdekatan",
      "• Jika elemen kiri lebih besar, maka ditukar posisinya",
      "• Proses diulang sampai tidak ada lagi pertukaran",
      "• Kompleksitas waktu: O(n²)"
    ]
  },
  {
    id: 2,
    title: "Mencari Bilangan Prima",
    category: "Matematika",
    icon: "🔢",
    description: "Menentukan apakah suatu bilangan adalah bilangan prima atau bukan.",
    code: [
      "ALGORITMA CekPrima",
      "  INPUT: bilangan n",
      "  OUTPUT: \"Prima\" atau \"Bukan Prima\"",
      "",
      "  JIKA n < 2 MAKA",
      "    KEMBALIKAN \"Bukan Prima\"",
      "  AKHIR JIKA",
      "",
      "  UNTUK i = 2 SAMPAI AKAR(n)",
      "    JIKA n MOD i = 0 MAKA",
      "      KEMBALIKAN \"Bukan Prima\"",
      "    AKHIR JIKA",
      "  AKHIR UNTUK",
      "",
      "  KEMBALIKAN \"Prima\""
    ],
    explanation: [
      "• Bilangan prima hanya habis dibagi 1 dan dirinya sendiri",
      "• Cukup cek pembagi sampai √n saja (optimasi)",
      "• Jika ditemukan pembagi selain 1 dan n, maka bukan prima",
      "• Contoh: 7 adalah prima, 12 bukan prima"
    ]
  },
  {
    id: 3,
    title: "Binary Search",
    category: "Pencarian",
    icon: "🔍",
    description: "Mencari elemen dalam array yang sudah terurut menggunakan pendekatan bagi dua.",
    code: [
      "ALGORITMA BinarySearch",
      "  INPUT: array terurut A[0..n-1], kunci x",
      "  OUTPUT: indeks x jika ditemukan, -1 jika tidak",
      "",
      "  kiri ← 0",
      "  kanan ← n - 1",
      "",
      "  SELAMA kiri <= kanan",
      "    tengah ← (kiri + kanan) / 2",
      "",
      "    JIKA A[tengah] = x MAKA",
      "      KEMBALIKAN tengah",
      "    JIKA A[tengah] < x MAKA",
      "      kiri ← tengah + 1",
      "    LAINNYA",
      "      kanan ← tengah - 1",
      "    AKHIR JIKA",
      "  AKHIR SELAMA",
      "",
      "  KEMBALIKAN -1"
    ],
    explanation: [
      "• Array harus sudah terurut terlebih dahulu",
      "• Setiap langkah membagi ruang pencarian menjadi setengah",
      "• Bandingkan elemen tengah dengan kunci pencarian",
      "• Kompleksitas waktu: O(log n) - sangat efisien"
    ]
  },
  {
    id: 4,
    title: "Faktorial (Rekursif)",
    category: "Rekursi",
    icon: "🔄",
    description: "Menghitung n! menggunakan pendekatan rekursif (fungsi memanggil dirinya sendiri).",
    code: [
      "FUNGSI Faktorial(n)",
      "  // Kasus dasar",
      "  JIKA n <= 1 MAKA",
      "    KEMBALIKAN 1",
      "  AKHIR JIKA",
      "",
      "  // Rekursi",
      "  KEMBALIKAN n × Faktorial(n - 1)",
      "",
      "// --- Program Utama ---",
      "BACA nilai n",
      "hasil ← Faktorial(n)",
      "CETAK \"Faktorial dari\", n, \"=\", hasil"
    ],
    explanation: [
      "• Faktorial: n! = n × (n-1) × (n-2) × ... × 1",
      "• Kasus dasar: 0! = 1 dan 1! = 1",
      "• Fungsi memanggil dirinya sendiri dengan n-1",
      "• Contoh: 5! = 5 × 4 × 3 × 2 × 1 = 120"
    ]
  },
  {
    id: 5,
    title: "Kalkulator Sederhana",
    category: "Kondisional",
    icon: "🧮",
    description: "Program kalkulator sederhana dengan operasi penjumlahan, pengurangan, perkalian, dan pembagian.",
    code: [
      "ALGORITMA Kalkulator",
      "  BACA bilangan1",
      "  BACA bilangan2",
      "  BACA operator",
      "",
      "  PILIH operator",
      "    KASUS '+':",
      "      hasil ← bilangan1 + bilangan2",
      "    KASUS '-':",
      "      hasil ← bilangan1 - bilangan2",
      "    KASUS '*':",
      "      hasil ← bilangan1 × bilangan2",
      "    KASUS '/':",
      "      JIKA bilangan2 = 0 MAKA",
      "        CETAK \"Error: tidak bisa dibagi nol\"",
      "        BERHENTI",
      "      AKHIR JIKA",
      "      hasil ← bilangan1 / bilangan2",
      "    DEFAULT:",
      "      CETAK \"Operator tidak valid\"",
      "      BERHENTI",
      "  AKHIR PILIH",
      "",
      "  CETAK \"Hasil =\", hasil"
    ],
    explanation: [
      "• Menggunakan struktur PILIH-KASUS (switch-case)",
      "• Menangani 4 operasi aritmatika dasar",
      "• Validasi: tidak boleh membagi dengan nol",
      "• Menampilkan pesan error jika operator tidak dikenal"
    ]
  },
  {
    id: 6,
    title: "Mencari Nilai Maksimum",
    category: "Array",
    icon: "📊",
    description: "Menemukan nilai terbesar dalam sebuah array bilangan.",
    code: [
      "ALGORITMA CariMaksimum",
      "  INPUT: array data[0..n-1]",
      "  OUTPUT: nilai maksimum",
      "",
      "  JIKA n = 0 MAKA",
      "    CETAK \"Array kosong\"",
      "    BERHENTI",
      "  AKHIR JIKA",
      "",
      "  maks ← data[0]",
      "",
      "  UNTUK i = 1 SAMPAI n-1",
      "    JIKA data[i] > maks MAKA",
      "      maks ← data[i]",
      "    AKHIR JIKA",
      "  AKHIR UNTUK",
      "",
      "  KEMBALIKAN maks"
    ],
    explanation: [
      "• Asumsikan elemen pertama adalah maksimum sementara",
      "• Bandingkan setiap elemen dengan nilai maksimum saat ini",
      "• Jika ditemukan elemen lebih besar, update maksimum",
      "• Kompleksitas waktu: O(n) - hanya satu kali iterasi"
    ]
  }
]

const categories = ["Semua", "Sorting", "Pencarian", "Matematika", "Rekursi", "Kondisional", "Array"]

function App() {
  const [selectedCategory, setSelectedCategory] = useState("Semua")
  const [selectedExample, setSelectedExample] = useState<PseudocodeExample>(pseudocodeExamples[0])
  const [copied, setCopied] = useState(false)

  const filteredExamples = selectedCategory === "Semua"
    ? pseudocodeExamples
    : pseudocodeExamples.filter(ex => ex.category === selectedCategory)

  const handleCopy = () => {
    const codeText = selectedExample.code.join('\n')
    navigator.clipboard.writeText(codeText)
    setCopied(true)
    setTimeout(() => setCopied(false), 2000)
  }

  const getKeywordColor = (line: string): JSX.Element[] => {
    const keywords = ['ALGORITMA', 'FUNGSI', 'INPUT', 'OUTPUT', 'UNTUK', 'SAMPAI', 'SELAMA', 'JIKA', 'MAKA', 'LAINNYA', 'AKHIR', 'KEMBALIKAN', 'BACA', 'CETAK', 'PILIH', 'KASUS', 'DEFAULT', 'BERHENTI', 'MOD']
    const parts: JSX.Element[] = []
    const words = line.split(/(\s+)/)

    words.forEach((word, idx) => {
      const cleanWord = word.replace(/[^\w]/g, '')
      if (keywords.includes(cleanWord)) {
        parts.push(<span key={idx} className="text-purple-400 font-bold">{word}</span>)
      } else if (word.includes('←')) {
        parts.push(<span key={idx} className="text-cyan-400">{word}</span>)
      } else if (word.startsWith('//')) {
        parts.push(<span key={idx} className="text-gray-500 italic">{word}</span>)
      } else if (word.startsWith('"') || word.startsWith('\"')) {
        parts.push(<span key={idx} className="text-green-400">{word}</span>)
      } else if (/^\d+$/.test(cleanWord)) {
        parts.push(<span key={idx} className="text-orange-400">{word}</span>)
      } else {
        parts.push(<span key={idx} className="text-gray-200">{word}</span>)
      }
    })

    return parts
  }

  return (
    <div className="min-h-screen bg-gradient-to-br from-gray-900 via-slate-900 to-gray-900 text-white">
      {/* Header */}
      <header className="border-b border-gray-700/50 backdrop-blur-sm bg-gray-900/50 sticky top-0 z-10">
        <div className="max-w-7xl mx-auto px-4 py-4 flex items-center justify-between">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-lg bg-gradient-to-br from-purple-500 to-blue-500 flex items-center justify-center text-xl">
              📝
            </div>
            <div>
              <h1 className="text-xl font-bold bg-gradient-to-r from-purple-400 to-blue-400 bg-clip-text text-transparent">
                Contoh Pseudocode
              </h1>
              <p className="text-xs text-gray-400">Belajar Algoritma dengan Mudah</p>
            </div>
          </div>
          <div className="text-sm text-gray-400 hidden sm:block">
            {pseudocodeExamples.length} contoh tersedia
          </div>
        </div>
      </header>

      <main className="max-w-7xl mx-auto px-4 py-8">
        {/* Intro Section */}
        <section className="mb-8 text-center">
          <h2 className="text-3xl font-bold mb-3">Apa itu Pseudocode?</h2>
          <p className="text-gray-400 max-w-2xl mx-auto leading-relaxed">
            Pseudocode adalah cara mendeskripsikan algoritma menggunakan bahasa yang mirip bahasa manusia,
            bukan bahasa pemrograman tertentu. Pseudocode membantu kita merancang logika program
            sebelum menulis kode yang sebenarnya.
          </p>
        </section>

        {/* Category Filter */}
        <section className="mb-6">
          <div className="flex flex-wrap gap-2 justify-center">
            {categories.map(cat => (
              <button
                key={cat}
                onClick={() => setSelectedCategory(cat)}
                className={`px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 ${
                  selectedCategory === cat
                    ? 'bg-purple-500 text-white shadow-lg shadow-purple-500/30'
                    : 'bg-gray-800 text-gray-300 hover:bg-gray-700 hover:text-white'
                }`}
              >
                {cat}
              </button>
            ))}
          </div>
        </section>

        {/* Example Cards Grid */}
        <section className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
          {filteredExamples.map(example => (
            <button
              key={example.id}
              onClick={() => setSelectedExample(example)}
              className={`text-left p-5 rounded-xl border transition-all duration-200 hover:scale-[1.02] ${
                selectedExample.id === example.id
                  ? 'bg-purple-500/10 border-purple-500/50 shadow-lg shadow-purple-500/10'
                  : 'bg-gray-800/50 border-gray-700/50 hover:border-gray-600 hover:bg-gray-800'
              }`}
            >
              <div className="flex items-start gap-3">
                <span className="text-2xl">{example.icon}</span>
                <div>
                  <h3 className="font-semibold text-white mb-1">{example.title}</h3>
                  <span className="text-xs px-2 py-0.5 rounded-full bg-gray-700 text-gray-300">
                    {example.category}
                  </span>
                  <p className="text-sm text-gray-400 mt-2">{example.description}</p>
                </div>
              </div>
            </button>
          ))}
        </section>

        {/* Code Display */}
        <section className="bg-gray-800/50 rounded-2xl border border-gray-700/50 overflow-hidden">
          {/* Code Header */}
          <div className="flex items-center justify-between px-6 py-4 border-b border-gray-700/50 bg-gray-800/80">
            <div className="flex items-center gap-3">
              <div className="flex gap-1.5">
                <div className="w-3 h-3 rounded-full bg-red-500"></div>
                <div className="w-3 h-3 rounded-full bg-yellow-500"></div>
                <div className="w-3 h-3 rounded-full bg-green-500"></div>
              </div>
              <span className="text-sm text-gray-400 ml-2">
                {selectedExample.icon} {selectedExample.title}
              </span>
            </div>
            <button
              onClick={handleCopy}
              className="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-gray-700 hover:bg-gray-600 text-sm text-gray-300 transition-colors"
            >
              {copied ? (
                <>
                  <span className="text-green-400">✓</span>
                  <span className="text-green-400">Tersalin!</span>
                </>
              ) : (
                <>
                  <span>📋</span>
                  <span>Salin</span>
                </>
              )}
            </button>
          </div>

          {/* Code Body */}
          <div className="grid grid-cols-1 lg:grid-cols-3">
            {/* Pseudocode */}
            <div className="lg:col-span-2 p-6 overflow-x-auto">
              <div className="font-mono text-sm leading-7">
                {selectedExample.code.map((line, idx) => (
                  <div key={idx} className="flex">
                    <span className="text-gray-600 select-none w-8 text-right mr-4 flex-shrink-0">
                      {line.trim() ? idx + 1 : ''}
                    </span>
                    <span className="whitespace-pre">
                      {line.trim() ? getKeywordColor(line) : ''}
                    </span>
                  </div>
                ))}
              </div>
            </div>

            {/* Explanation */}
            <div className="border-t lg:border-t-0 lg:border-l border-gray-700/50 p-6 bg-gray-900/30">
              <h4 className="font-semibold text-purple-400 mb-4 flex items-center gap-2">
                <span>💡</span> Penjelasan
              </h4>
              <div className="space-y-3">
                {selectedExample.explanation.map((text, idx) => (
                  <p key={idx} className="text-sm text-gray-300 leading-relaxed">
                    {text}
                  </p>
                ))}
              </div>

              {/* Keywords Legend */}
              <div className="mt-6 pt-4 border-t border-gray-700/50">
                <h5 className="text-xs font-semibold text-gray-500 uppercase mb-3">Keterangan Warna</h5>
                <div className="grid grid-cols-2 gap-2 text-xs">
                  <div className="flex items-center gap-2">
                    <span className="w-3 h-3 rounded bg-purple-400"></span>
                    <span className="text-gray-400">Keyword</span>
                  </div>
                  <div className="flex items-center gap-2">
                    <span className="w-3 h-3 rounded bg-cyan-400"></span>
                    <span className="text-gray-400">Operator</span>
                  </div>
                  <div className="flex items-center gap-2">
                    <span className="w-3 h-3 rounded bg-green-400"></span>
                    <span className="text-gray-400">String</span>
                  </div>
                  <div className="flex items-center gap-2">
                    <span className="w-3 h-3 rounded bg-orange-400"></span>
                    <span className="text-gray-400">Angka</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        {/* Tips Section */}
        <section className="mt-8 grid grid-cols-1 md:grid-cols-3 gap-4">
          <div className="p-5 rounded-xl bg-gray-800/30 border border-gray-700/30">
            <div className="text-2xl mb-2">📌</div>
            <h4 className="font-semibold mb-1">Kapan Menggunakan?</h4>
            <p className="text-sm text-gray-400">Gunakan pseudocode saat merancang algoritma, sebelum menulis kode program yang sebenarnya.</p>
          </div>
          <div className="p-5 rounded-xl bg-gray-800/30 border border-gray-700/30">
            <div className="text-2xl mb-2">✨</div>
            <h4 className="font-semibold mb-1">Keuntungan</h4>
            <p className="text-sm text-gray-400">Mudah dipahami, tidak terikat bahasa tertentu, dan fokus pada logika bukan sintaks.</p>
          </div>
          <div className="p-5 rounded-xl bg-gray-800/30 border border-gray-700/30">
            <div className="text-2xl mb-2">🎯</div>
            <h4 className="font-semibold mb-1">Tips Menulis</h4>
            <p className="text-sm text-gray-400">Gunakan kata kunci yang konsisten, indentasi yang jelas, dan bahasa yang mudah dipahami.</p>
          </div>
        </section>
      </main>

      {/* Footer */}
      <footer className="border-t border-gray-700/50 mt-12 py-6">
        <div className="max-w-7xl mx-auto px-4 text-center text-sm text-gray-500">
          <p>📝 Contoh Pseudocode — Belajar Algoritma dengan Mudah</p>
          <p className="mt-1">Pseudocode membantu memahami logika sebelum menulis kode</p>
        </div>
      </footer>
    </div>
  )
}

export default App
